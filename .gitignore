# OS / editor noise
.DS_Store
*.swp
*~

# Build artifacts and images
*.iso
*.img
build/

# Decrypted or plaintext secret material — never commit
*.dec
*.dec.yaml
*.plain
*.plain.yaml
*.agekey
key.txt

# Repo-local private key store (working tree only, never in git).
# No exceptions below this line — nothing in .keys/ is ever tracked.
.keys/

# cluster secrets dirs only allow encrypted SOPS files and documentation
clusters/*/secrets/**
!clusters/*/secrets/
!clusters/*/secrets/README.md
!clusters/*/secrets/*.sops.yaml
