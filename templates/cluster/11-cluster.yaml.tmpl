# Cluster Values — the SINGLE place this cluster's values are defined
# (ADR 0013). Pure data: no stages, no rendering. The installer's
# dispatcher converts every scalar key to KEY=VALUE in
# /etc/kairos-cluster/cluster.env (dash → underscore, uppercased); the
# shared renderers in configs/cluster/ consume it from there.

values:
  vip: "@VIP@"
  dns: "@CLUSTER_DNS@"
  gitops-repo: "@GITOPS_REPO@"
  gitops-path: "@GITOPS_PATH@"
